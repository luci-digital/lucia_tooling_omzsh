# custom files
custom/
# The CBB's vendored zsh command layer (modules/shell/zshrc/custom/) is first-party source, not an OMZ custom dir —
# the `custom/` rule above would silently un-track it (the 2026-09-30 credential_issuer.py lesson).
!modules/shell/zshrc/custom/
!modules/shell/zshrc/custom/**

# temp files directories
cache/
log/

# Vim swap/backup files
*.swp
*.swo

# macOS system files
.DS_Store

# editor configs
.idea

# tanstack / vite
node_modules
dist
dist-ssr
*.local
.env
.nitro
.tanstack
.wrangler
.output
.vinxi
__unconfig*

# zcompile cached files
*.zwc
*.zwc.old
